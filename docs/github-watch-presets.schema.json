{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightingale.local/schemas/github-watch-presets.schema.json",
  "title": "GitHub Watch Presets",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preset"
      }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "label"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
